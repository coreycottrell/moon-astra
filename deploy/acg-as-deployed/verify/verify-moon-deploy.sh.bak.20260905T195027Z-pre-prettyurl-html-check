#!/usr/bin/env bash
# verify-moon-deploy.sh — prove a MOON deploy actually worked.
#
# Written by ACG (fleet-lead) 2026-09-05 from the RUNNING system, then run
# against it. v2 2026-09-05: repaired under Codex's ACG-OPS-REVIEW-2026-09-05
# findings 1, 2, 6 and 9. Codex caught defects we did not; every repair below
# ships a control that was demonstrated to go BOTH red and green.
#
# DESIGN RULE, and the reason this file exists at all: every check ships a
# CONTROL that can go red. A probe that cannot fail is not evidence.
#
#   THE v1 DEFECTS, NAMED (so a future edit cannot quietly reintroduce them):
#
#   [F1] Section 9 hard-coded `assets/index-.*\.js`. The valid new build
#        references assets/game-*.js plus a shared preload assets/machines-*.js,
#        and the gallery is a SECOND page with its own entry script. Renaming
#        "index"→"game" would still have missed the second page and the shared
#        chunk. v2 PARSES both deployed entry pages and validates their ACTUAL
#        scripts / modulepreloads / stylesheets against the built artifacts.
#   [F1] v1 fetched no JavaScript and no GLB. The game's procedural fallback
#        means A MISSING MODEL STILL LEAVES THE PAGE PLAYABLE — a broken art
#        release looked fine. v2 fetches every model and compares status, GLB
#        magic bytes, byte count and SHA-256 against the built artifacts.
#   [F1] Section 9 sat inside the production-only branch, so --staging never
#        exercised the frontend at all. v2 runs it in BOTH modes.
#   [F2/F9] v1 could RETURN ZERO WITH REQUIRED CHECKS SKIPPED: SKIP incremented
#        but the script exited "$FAIL". A release job reading only the exit code
#        accepted an incomplete verification. v2 adds --strict and a distinct
#        INCOMPLETE exit code, and classifies every skip required vs advisory.
#   [F2] v1's backup gate required a historical RED row to pass its own control,
#        so a CORRECTLY FUNCTIONING new backup lane would FAIL it, and an old
#        failure never showed that today's check still discriminates. v2 runs the
#        SAME gate function over synthetic healthy/stale/invalid/wrong-label
#        fixtures in-process, every run. It also filters rows to the intended
#        --backup-label before deciding freshness.
#   [F6] v1 section 8 treated tick proximity as world IDENTITY. It is a LIVENESS
#        signal: reads happen at different times, and independent worlds can hold
#        similar counts. v2 keeps tick advancement as liveness, and corroborates
#        ROUTING with a marker request observed in the deployed proxy target's
#        own access log (both directions controlled) plus bracketed readings.
#
# EXIT CODES — a release job may read these alone:
#     0   COMPLETE + every required check passed
#   1-89  the number of FAILED checks
#    90   INCOMPLETE — --strict, zero failures, but required checks were SKIPPED
# Without --strict the old lenient behaviour is kept (skips do not change the
# exit code) but the run still prints RESULT: INCOMPLETE so a human sees it.
#
#   ./verify-moon-deploy.sh                       # production, lenient
#   ./verify-moon-deploy.sh --strict              # production, release gate
#   ./verify-moon-deploy.sh --staging --strict    # staging world + preview site
#   ./verify-moon-deploy.sh --site https://x/moon-astra --build-dir ./dist-aiciv
#
# Exit codes are captured directly from each command, never through a pipe:
# `curl ... | grep` reports grep's status and will happily call a 502 a pass.
# The Python helpers below run curl through subprocess and read .returncode and
# the -w '%{http_code}' value as two separate facts, for the same reason.

set -u

HOST_SSH="${MOON_SSH:-root@87.99.131.49}"
STRICT=0
SITE=""
BUILD_DIR=""
BACKUP_LABEL="${MOON_BACKUP_LABEL:-moon-astra-world}"
MODE="production"

while [ $# -gt 0 ]; do
  case "$1" in
    --staging)      MODE="staging" ;;
    --strict)       STRICT=1 ;;
    --site)         SITE="${2:-}"; shift ;;
    --api)          MOON_API="${2:-}"; export MOON_API; shift ;;
    --build-dir)    BUILD_DIR="${2:-}"; shift ;;
    --ssh)          HOST_SSH="${2:-}"; shift ;;
    --backup-label) BACKUP_LABEL="${2:-}"; shift ;;
    -h|--help)      sed -n '1,60p' "$0"; exit 0 ;;
    *) printf 'unknown argument: %s (try --help)\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

if [ "$MODE" = "staging" ]; then
  API="${MOON_API:-https://moon-astra-api-staging.ai-civ.com}"
  UNIT="moon-astra-staging"
  PORT=4181
  ORIGIN="https://deploy-moon-astra--aiciv-inc.netlify.app"
  LABEL="STAGING"
  EXPECT_LOG="/var/log/nginx/moon-astra-staging-api.access.log"
  OTHER_LOG="/var/log/nginx/moon-astra-api.access.log"
  OTHER_API="https://moon-astra-api.ai-civ.com"
  [ -n "$SITE" ] || SITE="$ORIGIN/moon-astra"
else
  API="${MOON_API:-https://moon-astra-api.ai-civ.com}"
  UNIT="moon-astra"
  PORT=4180
  ORIGIN="https://ai-civ.com"
  LABEL="PRODUCTION"
  EXPECT_LOG="/var/log/nginx/moon-astra-api.access.log"
  OTHER_LOG="/var/log/nginx/moon-astra-staging-api.access.log"
  OTHER_API="https://moon-astra-api-staging.ai-civ.com"
  [ -n "$SITE" ] || SITE="https://ai-civ.com/moon-astra"
fi

# Default build dir: dist-aiciv at the repo root three levels above this script
# (deploy/acg-as-deployed/verify/ -> repo root). Overridable with --build-dir.
if [ -z "$BUILD_DIR" ]; then
  _here="$(cd "$(dirname "$0")" && pwd)"
  for cand in "$_here/../../../dist-aiciv" "$_here/../../../dist" "$PWD/dist-aiciv"; do
    [ -d "$cand" ] && { BUILD_DIR="$(cd "$cand" && pwd)"; break; }
  done
fi

FAIL=0
SKIP_REQUIRED=0
SKIP_INFO=0
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

pass()      { printf '  PASS  %s\n' "$1"; }
fail()      { printf '  FAIL  %s\n' "$1"; FAIL=$((FAIL+1)); }
skipreq()   { printf '  SKIP* %s\n' "$1"; SKIP_REQUIRED=$((SKIP_REQUIRED+1)); }
skipinfo()  { printf '  skip  %s\n' "$1"; SKIP_INFO=$((SKIP_INFO+1)); }
section()   { printf '\n== %s\n' "$1"; }

printf '=== MOON deploy verification — %s (%s) ===\n' "$LABEL" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf 'site=%s\napi=%s\nbuild-dir=%s\nmode=%s\n' \
       "$SITE" "$API" "${BUILD_DIR:-<none>}" "$( [ "$STRICT" = 1 ] && echo strict || echo lenient )"
printf 'SKIP* = a REQUIRED check that did not run. In --strict it makes the run INCOMPLETE (exit 90).\n'

SSH_OK=0
if ssh -o ConnectTimeout=10 -o BatchMode=yes "$HOST_SSH" true 2>/dev/null; then SSH_OK=1; fi

# ---------------------------------------------------------------------------
section "1. Service is enabled and active on the host"
# WHY enabled AND active: `active` alone survives a manual start and dies at the
# next reboot. `enabled` is the boot-persistence claim.
if [ "$SSH_OK" = 1 ]; then
  ssh "$HOST_SSH" "systemctl is-enabled $UNIT" >/dev/null 2>&1
  [ $? -eq 0 ] && pass "$UNIT is enabled (survives reboot)" || fail "$UNIT is NOT enabled — it will not come back after a reboot"

  ssh "$HOST_SSH" "systemctl is-active $UNIT" >/dev/null 2>&1
  [ $? -eq 0 ] && pass "$UNIT is active" || fail "$UNIT is NOT active"

  # CONTROL: the same two commands against a unit that does not exist must fail.
  # Without this, a broken ssh/systemctl that always exits 0 reads as a green deploy.
  ssh "$HOST_SSH" "systemctl is-active moon-astra-does-not-exist" >/dev/null 2>&1
  [ $? -ne 0 ] && pass "CONTROL: is-active goes red on a nonexistent unit" || fail "CONTROL BROKEN: is-active returned 0 for a unit that does not exist — every result above is meaningless"

  section "2. The process is actually LISTENING (a started service is not a serving one)"
  # THE DEFECT THIS CATCHES is the one that cost us the first deploy: launched
  # through the `current` symlink WITHOUT --preserve-symlinks-main, the entrypoint
  # guard is false, the process exits 0 in ~50ms, and systemd reports a clean
  # start for a server that never bound a port. `is-active` was GREEN for it.
  ssh "$HOST_SSH" "ss -lnt | grep -q '127.0.0.1:$PORT'" >/dev/null 2>&1
  [ $? -eq 0 ] && pass "listening on 127.0.0.1:$PORT" || fail "NOTHING is listening on 127.0.0.1:$PORT — the classic silent no-op start"

  ssh "$HOST_SSH" "ss -lnt | grep -q '127.0.0.1:59999'" >/dev/null 2>&1
  [ $? -ne 0 ] && pass "CONTROL: the listener probe goes red on an unused port" || fail "CONTROL BROKEN: probe claims an unused port is listening"

  section "3. ExecStart names an interpreter that EXISTS on this host"
  # /usr/bin/node does not exist on aiciv-hub. A unit naming it fails at exec
  # (status=203/EXEC), not at runtime — the service never starts at all.
  EXECPATH=$(ssh "$HOST_SSH" "systemctl show $UNIT -p ExecStart --value" 2>/dev/null | grep -o '/[^ ]*/node' | head -1)
  if [ -n "$EXECPATH" ]; then
    ssh "$HOST_SSH" "test -x '$EXECPATH'" >/dev/null 2>&1
    [ $? -eq 0 ] && pass "interpreter $EXECPATH exists and is executable" || fail "interpreter $EXECPATH does NOT exist on the host"
    ssh "$HOST_SSH" "test -x /usr/bin/node" >/dev/null 2>&1
    [ $? -ne 0 ] && pass "CONTROL: /usr/bin/node correctly absent (this is why the template path was wrong)" || skipinfo "/usr/bin/node now exists — someone installed a distro node; re-check which one the unit uses (advisory, not a required check)"
  else
    fail "could not read ExecStart for $UNIT"
  fi

  section "4. --preserve-symlinks-main is present"
  ssh "$HOST_SSH" "systemctl show $UNIT -p ExecStart --value | grep -q -- --preserve-symlinks-main" >/dev/null 2>&1
  [ $? -eq 0 ] && pass "--preserve-symlinks-main is on the ExecStart line" || fail "--preserve-symlinks-main MISSING — this unit will start, exit 0, log nothing, and serve nothing"
else
  skipreq "host $HOST_SSH unreachable — sections 1-4 and the section-8 routing PROOF did not run"
fi

# ---------------------------------------------------------------------------
section "5. Health over public HTTPS, and the world is ADVANCING (LIVENESS)"
# A frozen tick is a dead simulation answering 200. Two reads, three seconds apart.
# F6: this is a LIVENESS signal and nothing more. It is NOT an identity proof and
# section 8 no longer treats it as one.
C1=$(curl -sS -m 15 -o "$TMP/h1.json" -w '%{http_code}' "$API/api/v1/health" 2>/dev/null)
RC=$?
if [ $RC -eq 0 ] && [ "$C1" = "200" ]; then
  pass "GET $API/api/v1/health -> 200"
else
  fail "health did not return 200 (curl rc=$RC http=$C1)"
fi
T1=$(python3 -c "import json,sys;print(json.load(open('$TMP/h1.json'))['tick'])" 2>/dev/null)
sleep 3
curl -sS -m 15 -o "$TMP/h2.json" "$API/api/v1/health" >/dev/null 2>&1
T2=$(python3 -c "import json,sys;print(json.load(open('$TMP/h2.json'))['tick'])" 2>/dev/null)
if [ -n "$T1" ] && [ -n "$T2" ] && [ "$T2" -gt "$T1" ] 2>/dev/null; then
  pass "tick advancing $T1 -> $T2 (simulation is alive, not just the HTTP layer)"
else
  fail "tick did NOT advance ($T1 -> $T2) — the server answers but the world is frozen"
fi

section "6. Catalog reports the economy ruleset the client was built against"
# The failure this catches is the expensive one: every check green, about the
# WRONG REVISION. A stale backend serves 200s all day.
curl -sS -m 15 -o "$TMP/cat.json" "$API/api/v1/catalog" >/dev/null 2>&1
python3 - "$TMP/cat.json" <<'PY'
import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception as e:
    print(f"  FAIL  catalog did not parse as JSON: {e}")
    sys.exit(1)
prod=d.get("production",{}); mind=d.get("mind",{})
checks=[("economyVersion",d.get("economyVersion"),2),
        ("production.refinery",prod.get("refinery"),100),
        ("production.standardHarvester",prod.get("standardHarvester"),300),
        ("production.bulkHarvester",prod.get("bulkHarvester"),400),
        ("production.rockPerMetal",prod.get("rockPerMetal"),2),
        ("mind.capacityPerNode",mind.get("capacityPerNode"),4),
        ("mind.costs.replicator",(mind.get("costs") or {}).get("replicator"),4)]
bad=[(n,g,w) for n,g,w in checks if g!=w]
for n,g,w in checks:
    print(("  PASS  " if g==w else "  FAIL  ")+f"{n} = {g!r} (expect {w!r})")
sys.exit(min(len(bad),89))
PY
CATRC=$?
[ "$CATRC" -eq 0 ] || FAIL=$((FAIL+CATRC))

section "7. Origin gate discriminates THREE ways (not just 'it answered')"
# A gate that returns the same thing for every input proves nothing. These two
# probes are non-mutating: neither can create a player.
B=$(curl -sS -m 15 -X POST -H 'Content-Type: application/json' \
      -H 'Origin: https://evil.example.com' -d '{"name":"controlprobe"}' \
      -o "$TMP/o1.json" -w '%{http_code}' "$API/api/v1/join" 2>/dev/null)
[ "$B" = "403" ] && pass "untrusted origin -> 403 (fails CLOSED)" || fail "untrusted origin returned $B, expected 403 — the origin gate is not holding"

N=$(curl -sS -m 15 -X POST -H 'Content-Type: application/json' \
      -H "Origin: $ORIGIN" -d '{"name":""}' \
      -o "$TMP/o2.json" -w '%{http_code}' "$API/api/v1/join" 2>/dev/null)
[ "$N" = "400" ] && pass "trusted origin + invalid name -> 400 (so 403 above was ABOUT THE ORIGIN, not a blanket refusal)" || fail "trusted origin + bad name returned $N, expected 400"

U=$(curl -sS -m 15 -o "$TMP/ob.json" -w '%{http_code}' "$API/api/v1/observe" 2>/dev/null)
[ "$U" = "401" ] && pass "unauthenticated observe -> 401" || fail "unauthenticated observe returned $U, expected 401"

# ---------------------------------------------------------------------------
section "8. The site proxy reaches the INTENDED world (routing, not tick identity)"
# F6 — WHAT CHANGED AND WHY. v1 asserted "proxy tick within 60 of direct tick =>
# same world" and called that identity. It is not: the two reads happen at
# different moments, and two independently started worlds can hold similar
# counts. Ticks stay here as a LIVENESS/corroboration signal only. The identity
# claim now rests on 8b: a uniquely marked request observed in the access log of
# the vhost we expect to be serving the site — with a positive control on BOTH
# logs, so "absent from the other log" cannot be an unreadable-file artefact.
P=$(curl -sS -m 20 -o "$TMP/p.json" -w '%{http_code}' "$SITE/api/v1/health" 2>/dev/null)
[ "$P" = "200" ] && pass "GET $SITE/api/v1/health -> 200" || fail "proxied health returned $P"

if [ "$SSH_OK" = 1 ]; then
  # The three markers must not be SUBSTRINGS of one another. They are grepped,
  # and the first draft of this check used a shared prefix with distinct
  # suffixes — so the staging POSITIVE CONTROL matched the proxy marker and the
  # run reported "the site is reaching the wrong world" about itself. Distinct
  # LEADING characters, so no marker can be found inside another.
  NBASE="$(date -u +%s)$$r$RANDOM"
  NONCE="vfyp${NBASE}"        # the request that goes through the site proxy
  NONCE_EXPECT="vfye${NBASE}" # positive control: straight at the intended API
  NONCE_OTHER="vfyo${NBASE}"  # positive control: straight at the other world
  curl -sS -m 20 -o /dev/null "$SITE/api/v1/health?vprobe=$NONCE" >/dev/null 2>&1
  curl -sS -m 20 -o /dev/null "$API/api/v1/health?vprobe=$NONCE_EXPECT" >/dev/null 2>&1
  curl -sS -m 20 -o /dev/null "$OTHER_API/api/v1/health?vprobe=$NONCE_OTHER" >/dev/null 2>&1
  sleep 2
  hits() { ssh "$HOST_SSH" "grep -c -- '$2' '$1' 2>/dev/null || true" 2>/dev/null | tr -d '[:space:]'; }
  H_EXPECT_SELF=$(hits "$EXPECT_LOG" "$NONCE_EXPECT")
  H_OTHER_SELF=$(hits "$OTHER_LOG" "$NONCE_OTHER")
  H_PROXY_EXPECT=$(hits "$EXPECT_LOG" "$NONCE")
  H_PROXY_OTHER=$(hits "$OTHER_LOG" "$NONCE")

  # CONTROLS FIRST: prove BOTH access logs are live and greppable this run.
  # Without these, "0 hits in the other log" could simply mean the file is
  # missing, rotated or unreadable — an absence that is not evidence.
  if [ "${H_EXPECT_SELF:-0}" -ge 1 ] 2>/dev/null; then
    pass "CONTROL: a direct request to $API is visible in $EXPECT_LOG (that log is live and greppable)"
  else
    fail "CONTROL BROKEN: a direct request to $API left no trace in $EXPECT_LOG — the routing instrument is blind, ignore 8b"
  fi
  if [ "${H_OTHER_SELF:-0}" -ge 1 ] 2>/dev/null; then
    pass "CONTROL: a direct request to $OTHER_API is visible in $OTHER_LOG (so 'absent from the other log' is a finding, not a blind spot)"
  else
    fail "CONTROL BROKEN: a direct request to $OTHER_API left no trace in $OTHER_LOG — cannot distinguish 'not routed there' from 'cannot see there'"
  fi

  if [ "${H_PROXY_EXPECT:-0}" -ge 1 ] 2>/dev/null; then
    pass "8b ROUTING PROOF: the marked request through $SITE was served by the $LABEL vhost ($EXPECT_LOG)"
  else
    fail "8b ROUTING PROOF: the marked request through $SITE never reached the $LABEL vhost — the site is NOT proxying where this mode expects"
  fi
  if [ "${H_PROXY_OTHER:-0}" -eq 0 ] 2>/dev/null; then
    pass "8b ROUTING PROOF: that same request did NOT reach the other world's vhost ($OTHER_LOG)"
  else
    fail "8b ROUTING PROOF: the marked request ALSO appeared in $OTHER_LOG — the site is reaching the wrong world"
  fi
else
  skipreq "routing PROOF (8b) needs host access to read the per-vhost nginx logs — ticks below are corroboration ONLY, not an identity proof"
fi

# 8c — bracketed readings. Corroboration, explicitly not identity.
# Read direct-BEFORE, then the proxy, then direct-AFTER. If the proxy is the
# same world, its tick must lie inside the bracket the direct reads pin down.
D1=$(curl -sS -m 15 "$API/api/v1/health" 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin)['tick'])" 2>/dev/null)
PT=$(curl -sS -m 20 "$SITE/api/v1/health" 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin)['tick'])" 2>/dev/null)
D2=$(curl -sS -m 15 "$API/api/v1/health" 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin)['tick'])" 2>/dev/null)
O1=$(curl -sS -m 15 "$OTHER_API/api/v1/health" 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin)['tick'])" 2>/dev/null)
O2=$(curl -sS -m 15 "$OTHER_API/api/v1/health" 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin)['tick'])" 2>/dev/null)
if [ -n "$D1" ] && [ -n "$PT" ] && [ -n "$D2" ] && [ "$PT" -ge "$D1" ] && [ "$PT" -le "$D2" ] 2>/dev/null; then
  pass "8c corroboration: proxy tick $PT lies inside the bracketed direct reads [$D1,$D2] (consistent with the intended world)"
else
  fail "8c corroboration: proxy tick $PT is OUTSIDE the bracketed direct reads [$D1,$D2] — the proxy is not tracking the intended world"
fi
if [ -n "$O1" ] && [ -n "$PT" ] && [ -n "$O2" ] && [ "$PT" -ge "$O1" ] && [ "$PT" -le "$O2" ] 2>/dev/null; then
  fail "8c corroboration: proxy tick $PT lies inside the OTHER world's bracket [$O1,$O2] — either the proxy is tracking that world, or the two are momentarily indistinguishable by tick. 8b is the authority; ticks alone never were."
else
  pass "8c corroboration: proxy tick $PT lies outside the other world's bracket [$O1,$O2] (the two worlds are distinguishable right now)"
fi

# ---------------------------------------------------------------------------
# F1 — SECTION 9 NOW RUNS IN BOTH MODES. In v1 it lived inside `if PRODUCTION`,
# so --staging never exercised the frontend at all.
section "9. Entry pages, their ACTUAL assets, and the GLB models"
if [ -z "$BUILD_DIR" ] || [ ! -d "$BUILD_DIR" ]; then
  skipreq "no build directory found (pass --build-dir) — cannot compare deployed bytes against built artifacts"
else
python3 - "$SITE" "$BUILD_DIR" "$TMP" <<'PY'
import hashlib, json, os, re, subprocess, sys

SITE, BUILD, TMP = sys.argv[1], sys.argv[2], sys.argv[3]
SITE = SITE.rstrip('/')
fails = 0

def ok(m):
    print(f"  PASS  {m}")
def no(m):
    global fails
    fails += 1
    print(f"  FAIL  {m}")

def fetch(url, dest):
    """Return (curl_rc, http_code). Both captured DIRECTLY — never through a pipe."""
    p = subprocess.run(
        ["curl", "-sS", "-m", "30", "-o", dest, "-w", "%{http_code}", "-L", url],
        capture_output=True, text=True)
    return p.returncode, (p.stdout.strip() or "000")

def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for c in iter(lambda: f.read(1 << 20), b""):
            h.update(c)
    return h.hexdigest()

def is_glb(path):
    """GLB container magic is the four ASCII bytes 'glTF' (0x46546C67 LE)."""
    with open(path, "rb") as f:
        return f.read(4) == b"glTF"

# --- refs parser -----------------------------------------------------------
SCRIPT_RE = re.compile(r'<script\b[^>]*\bsrc\s*=\s*["\']([^"\']+)["\']', re.I)
LINK_RE   = re.compile(r'<link\b[^>]*>', re.I)
REL_RE    = re.compile(r'\brel\s*=\s*["\']([^"\']+)["\']', re.I)
HREF_RE   = re.compile(r'\bhref\s*=\s*["\']([^"\']+)["\']', re.I)

def refs(html_text):
    """Every asset the browser is actually told to load from this page."""
    out = set()
    for m in SCRIPT_RE.finditer(html_text):
        out.add(("script", m.group(1)))
    for tag in LINK_RE.finditer(html_text):
        t = tag.group(0)
        rel = REL_RE.search(t)
        href = HREF_RE.search(t)
        if not rel or not href:
            continue
        r = rel.group(1).lower().strip()
        if r in ("modulepreload", "preload", "stylesheet"):
            out.add((r, href.group(1)))
    return out

def to_url(ref):
    """/moon-astra/assets/x.js -> <site-origin>/moon-astra/assets/x.js"""
    if ref.startswith("http"):
        return ref
    if ref.startswith("/"):
        m = re.match(r'^(https?://[^/]+)', SITE)
        return m.group(1) + ref
    return SITE + "/" + ref.lstrip("./")

# --- 9a: both entry pages, and the reference SETS they declare --------------
print("  ---- 9a: entry pages")
pages = {"index.html": SITE + "/", "machines.html": SITE + "/machines.html"}
deployed_refs = set()
built_refs = set()
page_bodies = {}
for name, url in pages.items():
    lp = os.path.join(BUILD, name)
    if not os.path.isfile(lp):
        no(f"build dir has no {name} — cannot verify the {'gallery' if 'machines' in name else 'game'} page")
        continue
    dest = os.path.join(TMP, "dep_" + name)
    rc, code = fetch(url, dest)
    if rc == 0 and code == "200":
        ok(f"{url} -> 200")
    else:
        no(f"{url} returned http={code} (curl rc={rc}) — this entry page is NOT deployed")
        continue
    page_bodies[name] = dest
    ds, bs = sha(dest), sha(lp)
    if ds == bs:
        ok(f"{name} deployed bytes == built bytes (sha256 {ds[:12]}…)")
    else:
        no(f"{name} deployed sha256 {ds[:12]}… != built {bs[:12]}… — a DIFFERENT build is live at this URL")
    dtext = open(dest, encoding="utf-8", errors="replace").read()
    btext = open(lp, encoding="utf-8", errors="replace").read()
    dr, br = refs(dtext), refs(btext)
    deployed_refs |= dr
    built_refs |= br
    if not dr:
        no(f"{name} declares NO script/preload/stylesheet at all — the parser found nothing to verify")
    elif dr == br:
        ok(f"{name} references exactly the built set ({len(dr)}: " + ", ".join(sorted(r.rsplit('/',1)[-1] for _, r in dr)) + ")")
    else:
        no(f"{name} reference set differs — deployed-only {sorted(x[1] for x in dr-br)} / built-only {sorted(x[1] for x in br-dr)}")

# --- 9b: fetch every referenced asset and compare bytes + sha256 ------------
print("  ---- 9b: the actual scripts, module preloads and stylesheets")
if not deployed_refs:
    no("no asset references were parsed from any entry page — nothing was verified")
asset_bodies = {}
for kind, ref in sorted(deployed_refs, key=lambda x: x[1]):
    tail = ref.split("?")[0]
    base = tail.rsplit("/", 1)[-1]
    lp = os.path.join(BUILD, "assets", base) if "/assets/" in tail else os.path.join(BUILD, tail.lstrip("/"))
    dest = os.path.join(TMP, "asset_" + base)
    rc, code = fetch(to_url(ref), dest)
    if rc != 0 or code != "200":
        no(f"[{kind}] {base} -> http={code} (curl rc={rc}) — referenced by a live page and NOT SERVED")
        continue
    if not os.path.isfile(lp):
        no(f"[{kind}] {base} served, but no matching file in the build dir at {lp} — cannot attest it")
        continue
    dbytes, bbytes = os.path.getsize(dest), os.path.getsize(lp)
    ds, bs = sha(dest), sha(lp)
    if dbytes == bbytes and ds == bs:
        ok(f"[{kind}] {base} 200, {dbytes} B, sha256 {ds[:12]}… matches the build")
    else:
        no(f"[{kind}] {base} MISMATCH — served {dbytes} B/{ds[:12]}… vs built {bbytes} B/{bs[:12]}…")
    if base.endswith(".js"):
        asset_bodies[base] = dest

# every built asset must be reachable from an entry page (directly or via a
# reference inside one of the fetched scripts) — this is the check that would
# have caught v1's blind spot: a shared chunk nobody looked at.
built_assets = set()
adir = os.path.join(BUILD, "assets")
if os.path.isdir(adir):
    built_assets = {f for f in os.listdir(adir) if not f.startswith(".")}
reached = {r.split("?")[0].rsplit("/", 1)[-1] for _, r in deployed_refs}
for p in list(asset_bodies.values()):
    body = open(p, encoding="utf-8", errors="replace").read()
    reached |= set(re.findall(r'assets/([A-Za-z0-9._-]+\.(?:js|css))', body))
orphans = sorted(built_assets - reached)
if not built_assets:
    no(f"build dir has no assets/ directory at {adir}")
elif orphans:
    no(f"built assets NOT referenced by either entry page or any fetched script: {orphans} — either the parser is blind to them or they are dead weight")
else:
    ok(f"all {len(built_assets)} built assets are reachable from the two entry pages (no unchecked chunk)")

# --- 9c: the GLB models -----------------------------------------------------
# CODEX'S SHARPEST POINT: the game's procedural fallback means a MISSING MODEL
# STILL LEAVES THE PAGE PLAYABLE. Status alone is not enough either — a 404 on
# this site returns a ~3.4 KB HTML body, so a naive "did I get bytes?" check
# passes on the failure. Status + GLB magic + byte count + SHA-256, all four.
print("  ---- 9c: GLB models")
versions = set()
for p in asset_bodies.values():
    body = open(p, encoding="utf-8", errors="replace").read()
    versions |= set(re.findall(r'models/([A-Za-z0-9._-]+)/', body))
    versions |= set(re.findall(r'models/([A-Za-z0-9._-]+)\b', body))
versions = {v for v in versions if v not in ("", ".", "..")}
built_versions = set()
mdir = os.path.join(BUILD, "models")
if os.path.isdir(mdir):
    built_versions = {d for d in os.listdir(mdir) if os.path.isdir(os.path.join(mdir, d))}

if not versions:
    no("no models/<version> directory is referenced by any deployed script — the client will never request a model (procedural fallback would hide this)")
elif not versions <= built_versions:
    no(f"deployed scripts request model versions {sorted(versions)} but the build only contains {sorted(built_versions)}")
else:
    ok(f"deployed scripts request model version(s) {sorted(versions)}, present in the build")

for ver in sorted(versions & built_versions):
    manp = os.path.join(mdir, ver, "manifest.json")
    if not os.path.isfile(manp):
        no(f"{ver}/manifest.json missing from the build — cannot attest the models")
        continue
    man = json.load(open(manp))
    models = man.get("models", {})
    if len(models) != 6:
        no(f"{ver}/manifest.json declares {len(models)} models, expected 6")
    else:
        ok(f"{ver}/manifest.json declares all 6 models")

    dest = os.path.join(TMP, f"man_{ver}.json")
    rc, code = fetch(f"{SITE}/models/{ver}/manifest.json", dest)
    if rc == 0 and code == "200" and sha(dest) == sha(manp):
        ok(f"{ver}/manifest.json served and byte-identical to the build")
    else:
        no(f"{ver}/manifest.json http={code} (curl rc={rc}) or bytes differ from the build")

    for key, meta in sorted(models.items()):
        fn = meta.get("file", f"{key}.glb")
        lp = os.path.join(mdir, ver, fn)
        dest = os.path.join(TMP, f"model_{ver}_{fn}")
        rc, code = fetch(f"{SITE}/models/{ver}/{fn}", dest)
        if rc != 0 or code != "200":
            no(f"model {ver}/{fn} -> http={code} (curl rc={rc}) — MISSING. The procedural fallback hides this in the browser: the page still plays.")
            continue
        if not os.path.isfile(lp):
            no(f"model {ver}/{fn} served but absent from the build dir — cannot attest it")
            continue
        if not is_glb(dest):
            head = open(dest, "rb").read(4)
            no(f"model {ver}/{fn} returned 200 but is NOT a GLB (first 4 bytes {head!r}) — an HTML error page served with a 200")
            continue
        dbytes, bbytes, mbytes = os.path.getsize(dest), os.path.getsize(lp), meta.get("bytes")
        ds, bs, ms = sha(dest), sha(lp), meta.get("sha256")
        problems = []
        if dbytes != bbytes: problems.append(f"served {dbytes} B vs built {bbytes} B")
        if mbytes is not None and bbytes != mbytes: problems.append(f"built {bbytes} B vs manifest {mbytes} B")
        if ds != bs: problems.append(f"served sha {ds[:12]}… vs built {bs[:12]}…")
        if ms and bs != ms: problems.append(f"built sha {bs[:12]}… vs manifest {ms[:12]}…")
        if problems:
            no(f"model {ver}/{fn} " + "; ".join(problems))
        else:
            ok(f"model {ver}/{fn} 200, GLB magic ok, {dbytes} B, sha256 {ds[:12]}… == build == manifest")

# --- 9d: CONTROLS -----------------------------------------------------------
print("  ---- 9d: controls (each must be able to go red)")
d = os.path.join(TMP, "ctl_asset")
rc, code = fetch(SITE + "/assets/index-DOES-NOT-EXIST.js", d)
if code == "404":
    ok("CONTROL: a missing asset 404s (no SPA fallback masking broken builds)")
else:
    no(f"CONTROL: missing asset returned {code}, not 404 — an SPA fallback is hiding missing assets")

ver_for_ctl = sorted(versions & built_versions) or sorted(built_versions) or ["industrial-01"]
d = os.path.join(TMP, "ctl_model")
rc, code = fetch(f"{SITE}/models/{ver_for_ctl[0]}/DOES-NOT-EXIST.glb", d)
if code == "404":
    ok("CONTROL: a missing MODEL 404s (kept from v1's spirit — proves the model probe can observe absence)")
else:
    no(f"CONTROL: missing model returned {code}, not 404 — model absence would be invisible to this run")

# the GLB magic detector must reject a non-GLB, or 'it is a GLB' proves nothing
if os.path.getsize(d) > 0 and not is_glb(d):
    ok(f"CONTROL: the GLB magic test REJECTS the {os.path.getsize(d)} B error-page body (so 'GLB magic ok' above is a real finding)")
elif os.path.getsize(d) == 0:
    print("  skip  GLB-magic negative control: the 404 body was empty; magic test not exercised against real non-GLB bytes")
else:
    no("CONTROL BROKEN: the GLB magic test accepted a non-GLB error page")

# the sha256 comparator must go red on a one-byte change
probe_src = None
for cand in sorted(built_assets):
    probe_src = os.path.join(adir, cand); break
if probe_src and os.path.isfile(probe_src):
    corrupt = os.path.join(TMP, "ctl_corrupt")
    b = bytearray(open(probe_src, "rb").read())
    b[0] ^= 0xFF
    open(corrupt, "wb").write(bytes(b))
    if sha(corrupt) != sha(probe_src) and os.path.getsize(corrupt) == os.path.getsize(probe_src):
        ok("CONTROL: the sha256 comparator goes RED on a one-byte change at identical length (byte counts alone would not have caught it)")
    else:
        no("CONTROL BROKEN: the sha256 comparator did not detect a one-byte change — every hash PASS above is meaningless")
else:
    no("CONTROL: could not build a corruption probe — no built asset to mutate")

sys.exit(min(fails, 89))
