    last = greens[-1]
    ts = datetime.datetime.strptime(last["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(
        tzinfo=datetime.timezone.utc)
    age = (now - ts).total_seconds() / 3600
    good = age < MAX_AGE_H
    out.append((good, f"newest GREEN snapshot for {label} is {age:.2f}h old "
                      f"(hourly lane; >={MAX_AGE_H:g}h means it stopped)"))
    ok &= good
    for k in REQUIRED_FLAGS:
        v = last.get(k)
        out.append((bool(v), f"{k} = {v}"))
        ok &= bool(v)
    integ = last.get("integrity") == "ok"
    out.append((integ, f"restored-copy integrity_check = {last.get('integrity')}"))
    ok &= integ
